{
  "name": "folionote",
  "version": "0.1.0",
  "private": false,
  "description": "Turn a Notion page into a fast static site you host yourself (Next.js + react-notion-x).",
  "author": "nobel6018 <nobel6018@gmail.com>",
  "repository": "nobel6018/folionote",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm core:build && next dev",
    "build": "pnpm core:build && next build",
    "start": "next start",
    "core:build": "pnpm --filter @folionote/core build",
    "core:watch": "pnpm --filter @folionote/core exec tsc -p tsconfig.build.json --watch",
    "typecheck": "pnpm core:build && tsc --noEmit",
    "deploy": "vercel deploy",
    "changeset": "changeset",
    "release": "pnpm core:build && changeset publish",
    "version-packages": "changeset version",
    "deps:upgrade": "[ -z $GITHUB_ACTIONS ] && pnpm up -L notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:update on CI'",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "run-p test:*",
    "test:lint": "eslint .",
    "test:prettier": "prettier '**/*.{js,jsx,mjs,ts,tsx}' --check"
  },
  "dependencies": {
    "@folionote/core": "workspace:*",
    "@react-icons/all-files": "^4.1.0",
    "fathom-client": "^3.4.1",
    "ky": "^1.8.1",
    "next": "^15.5.3",
    "next-themes": "^0.4.6",
    "notion-types": "^7.7.0",
    "notion-utils": "^7.7.0",
    "posthog-js": "^1.249.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@fisch0920/config": "^1.2.1",
    "@next/bundle-analyzer": "^15.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "cacheable-request": {
      "keyv": "npm:@keyvhq/core@~1.6.6"
    }
  },
  "prettier": "@fisch0920/config/prettier",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --ignore-unknown --write",
      "eslint --fix"
    ]
  }
}
