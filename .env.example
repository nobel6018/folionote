# ------------------------------------------------------------------------------
# 환경변수 예시.
#
# 여기 있는 값은 전부 선택입니다. 하나도 넣지 않아도 사이트는 뜹니다.
# 필요한 기능을 켤 때만 해당 줄의 주석을 풀고 채우세요.
#
# 로컬에서는 이 파일을 `.env`로 복사해 쓰고, 배포에서는 호스팅의 환경변수 설정에
# 넣습니다(.env는 gitignore에 있습니다).
# ------------------------------------------------------------------------------

# ── 브라우저에서 설정을 고치는 어드민 (/admin) ────────────────────────────────
#
# 아래 값이 다 채워졌을 때만 배포 어드민이 켜집니다. 하나라도 없으면 /admin은
# 401이 아니라 404입니다. OSS라 경로가 이미 알려져 있어서, 있다는 사실 자체를
# 숨기는 쪽으로 뒀습니다. 별도의 ON/OFF 플래그는 두지 않았습니다(fail-closed).
#
# 만드는 방법과 OAuth 앱 설정은 docs/admin-deploy.md 를 보세요.
#GITHUB_OAUTH_CLIENT_ID=
#GITHUB_OAUTH_CLIENT_SECRET=
# 세션 쿠키 암호화 키. `openssl rand -base64 32` 로 만듭니다
#ADMIN_SESSION_SECRET=

# 커밋 대상 리포 (`owner/repo`).
# Vercel git 연동 프로젝트에서는 VERCEL_GIT_REPO_OWNER/SLUG로 자동 인식하므로
# 비워둡니다. 다른 호스트에서만 직접 넣으세요.
#GITHUB_REPO=
# 커밋할 브랜치. 기본은 현재 배포 브랜치
#GITHUB_BRANCH=
# 리포 안의 설정 파일 경로. 기본 site.config.ts
#ADMIN_CONFIG_PATH=

# ── 분석 ──────────────────────────────────────────────────────────────────────
# Fathom
#NEXT_PUBLIC_FATHOM_ID=
# PostHog
#NEXT_PUBLIC_POSTHOG_ID=

# ── 트윗 임베드 ───────────────────────────────────────────────────────────────
# 넣으면 트윗을 서버에서 미리 받아 더 빠르게 그립니다
#TWITTER_ACCESS_TOKEN=

# ── Redis ─────────────────────────────────────────────────────────────────────
# 미리보기 이미지 캐시와 페이지뷰 카운트에 씁니다. 페이지뷰는 Redis 없이는
# 동작하지 않습니다(서버리스 인메모리 카운터는 인스턴스마다 따로 세기 때문).
# REDIS_HOST와 REDIS_PASSWORD만 있으면 됩니다. 다만 켜는 스위치가 따로 있어서
# site.config.ts의 isRedisEnabled를 true로 두거나 REDIS_ENABLED를 채워야 합니다.
#REDIS_ENABLED=
#REDIS_HOST=
#REDIS_PASSWORD=
#REDIS_USER='default'
#REDIS_NAMESPACE='preview-images'
